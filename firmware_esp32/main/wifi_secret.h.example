//
//  Luu y:
//    * wifi_secret.h KHONG duoc commit (da co trong .gitignore) — moi nguoi dung
//      phai tu dien SSID/mat khau cua minh.
//    * Neu de nguyen "CHANGE_ME" thi board van chay (camera, canh bao, serial)
//      nhung web server se khong vao duoc mang.
//
